<Window x:Class="Tetris.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tetris"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#030405">

        <Window.Resources>

                <LinearGradientBrush x:Key="ScreenBackground"
                                     StartPoint="0,0"
                                     EndPoint="1,1">
                        <GradientStop Color="#030405"
                                      Offset="0"/>
                        <GradientStop Color="#080B0E"
                                      Offset="0.5"/>
                        <GradientStop Color="#020304"
                                      Offset="1"/>
                </LinearGradientBrush>

                <RadialGradientBrush x:Key="GoldAtmosphere"
                                     Center="0.18,0.28"
                                     GradientOrigin="0.18,0.28"
                                     RadiusX="0.75"
                                     RadiusY="0.75">
                        <GradientStop Color="#302710"
                                      Offset="0"/>
                        <GradientStop Color="#171309"
                                      Offset="0.35"/>
                        <GradientStop Color="#080808"
                                      Offset="0.72"/>
                        <GradientStop Color="#000000"
                                      Offset="1"/>
                </RadialGradientBrush>

                <RadialGradientBrush x:Key="BlueAtmosphere"
                                     Center="0.82,0.72"
                                     GradientOrigin="0.82,0.72"
                                     RadiusX="0.72"
                                     RadiusY="0.72">
                        <GradientStop Color="#0C202B"
                                      Offset="0"/>
                        <GradientStop Color="#08141B"
                                      Offset="0.38"/>
                        <GradientStop Color="#050809"
                                      Offset="0.72"/>
                        <GradientStop Color="#000000"
                                      Offset="1"/>
                </RadialGradientBrush>

                <LinearGradientBrush x:Key="PanelBackground"
                                     StartPoint="0,0"
                                     EndPoint="0,1">
                        <GradientStop Color="#181818"
                                      Offset="0"/>
                        <GradientStop Color="#0D0D0D"
                                      Offset="1"/>
                </LinearGradientBrush>

                <LinearGradientBrush x:Key="ButtonBackground"
                                     StartPoint="0,0"
                                     EndPoint="0,1">
                        <GradientStop Color="#1C1C1C"
                                      Offset="0"/>
                        <GradientStop Color="#101010"
                                      Offset="1"/>
                </LinearGradientBrush>

                <Style x:Key="MenuButtonStyle"
                       TargetType="Button">

                        <Setter Property="Width"
                                Value="240"/>

                        <Setter Property="Height"
                                Value="52"/>

                        <Setter Property="Margin"
                                Value="0,6"/>

                        <Setter Property="FontSize"
                                Value="17"/>

                        <Setter Property="FontWeight"
                                Value="Bold"/>

                        <Setter Property="Foreground"
                                Value="White"/>

                        <Setter Property="Background"
                                Value="{StaticResource ButtonBackground}"/>

                        <Setter Property="BorderBrush"
                                Value="#B89B4A"/>

                        <Setter Property="BorderThickness"
                                Value="1"/>

                        <Setter Property="Cursor"
                                Value="Hand"/>

                        <Setter Property="Template">

                                <Setter.Value>

                                        <ControlTemplate TargetType="Button">

                                                <Border x:Name="ButtonBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="5">

                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>

                                                </Border>

                                                <ControlTemplate.Triggers>

                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">

                                                                <Setter TargetName="ButtonBorder"
                                                                        Property="Background"
                                                                        Value="#29251A"/>

                                                                <Setter TargetName="ButtonBorder"
                                                                        Property="BorderBrush"
                                                                        Value="#E0C46B"/>

                                                        </Trigger>

                                                        <Trigger Property="IsPressed"
                                                                 Value="True">

                                                                <Setter TargetName="ButtonBorder"
                                                                        Property="Background"
                                                                        Value="#3A321D"/>

                                                                <Setter TargetName="ButtonBorder"
                                                                        Property="BorderBrush"
                                                                        Value="#F0D77A"/>

                                                        </Trigger>

                                                        <Trigger Property="IsEnabled"
                                                                 Value="False">

                                                                <Setter TargetName="ButtonBorder"
                                                                        Property="Opacity"
                                                                        Value="0.45"/>

                                                        </Trigger>

                                                </ControlTemplate.Triggers>

                                        </ControlTemplate>

                                </Setter.Value>

                        </Setter>

                </Style>

                <Style x:Key="LogoLetterStyle"
                       TargetType="TextBlock">

                        <Setter Property="FontSize"
                                Value="72"/>

                        <Setter Property="FontWeight"
                                Value="Black"/>

                        <Setter Property="Margin"
                                Value="1,0"/>

                </Style>

                <Style x:Key="ScreenTitleStyle"
                       TargetType="TextBlock">

                        <Setter Property="Foreground"
                                Value="White"/>

                        <Setter Property="FontSize"
                                Value="38"/>

                        <Setter Property="FontWeight"
                                Value="Bold"/>

                        <Setter Property="HorizontalAlignment"
                                Value="Center"/>

                </Style>

                <DrawingBrush x:Key="AnimatedGridBrush"
                              TileMode="Tile"
                              Viewport="0,0,80,80"
                              ViewportUnits="Absolute"
                              Viewbox="0,0,80,80"
                              ViewboxUnits="Absolute">

                        <DrawingBrush.Drawing>

                                <DrawingGroup>

                                        <GeometryDrawing Brush="#05080A"
                                                         Geometry="M0,0 L80,0 L80,80 L0,80 Z"/>

                                        <GeometryDrawing Brush="#263238"
                                                         Geometry="M0,0 L80,0 L80,1 L0,1 Z M0,0 L1,0 L1,80 L0,80 Z"/>

                                </DrawingGroup>

                        </DrawingBrush.Drawing>

                </DrawingBrush>

                <Style x:Key="PanelStyle"
                       TargetType="Border">

                        <Setter Property="Background"
                                Value="{StaticResource PanelBackground}"/>

                        <Setter Property="BorderBrush"
                                Value="#B89B4A"/>

                        <Setter Property="BorderThickness"
                                Value="1"/>

                        <Setter Property="CornerRadius"
                                Value="8"/>

                </Style>

        </Window.Resources>

        <Grid>

                <Canvas x:Name="AnimatedBackground"
                        Panel.ZIndex="0"
                        IsHitTestVisible="False"
                        ClipToBounds="True">


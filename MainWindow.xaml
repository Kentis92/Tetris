<Window x:Class="Tetris.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tetris"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#080808">

        <Grid>

                <Grid x:Name="LoginScreen"
                      Background="#080808"
                      Panel.ZIndex="10">

                        <Border Width="430"
                                Padding="45"
                                Background="#111111"
                                BorderBrush="#B89B4A"
                                BorderThickness="2"
                                CornerRadius="8"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                                <StackPanel>

                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,0,0,35">

                                                <TextBlock Text="T"
                                                           Foreground="Cyan"
                                                           FontSize="52"
                                                           FontWeight="Bold"/>

                                                <TextBlock Text="E"
                                                           Foreground="Yellow"
                                                           FontSize="52"
                                                           FontWeight="Bold"/>

                                                <TextBlock Text="T"
                                                           Foreground="Purple"
                                                           FontSize="52"
                                                           FontWeight="Bold"/>

                                                <TextBlock Text="R"
                                                           Foreground="Green"
                                                           FontSize="52"
                                                           FontWeight="Bold"/>

                                                <TextBlock Text="I"
                                                           Foreground="Red"
                                                           FontSize="52"
                                                           FontWeight="Bold"/>

                                                <TextBlock Text="S"
                                                           Foreground="Blue"
                                                           FontSize="52"
                                                           FontWeight="Bold"/>

                                        </StackPanel>

                                        <TextBlock Text="LOGIN"
                                                   Foreground="White"
                                                   FontSize="24"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,25"/>

                                        <TextBlock Text="USERNAME"
                                                   Foreground="Gray"
                                                   FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,5"/>

                                        <TextBox x:Name="LoginUsernameTextBox"
                                                 Width="220"
                                                 Height="32"
                                                 FontSize="16"
                                                 HorizontalContentAlignment="Center"
                                                 Margin="0,0,0,15"/>

                                        <TextBlock Text="PASSWORD"
                                                   Foreground="Gray"
                                                   FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,5"/>

                                        <PasswordBox x:Name="LoginPasswordBox"
                                                     Width="220"
                                                     Height="32"
                                                     FontSize="16"
                                                     HorizontalContentAlignment="Center"
                                                     Margin="0,0,0,25"/>

                                        <Button Content="LOGIN"
                                                Width="220"
                                                Height="40"
                                                FontSize="17"
                                                FontWeight="Bold"
                                                Margin="0,0,0,10"
                                                Click="LoginButton_Click"/>

                                        <Button Content="REGISTER"
                                                Width="220"
                                                Height="40"
                                                FontSize="17"
                                                Margin="0,0,0,10"
                                                Click="RegisterButton_Click"/>

                                        <Button Content="EXIT"
                                                Width="220"
                                                Height="40"
                                                FontSize="17"
                                                Click="ExitButton_Click"/>

                                </StackPanel>
                        </Border>
                </Grid>

                <Grid x:Name="MainMenuScreen"
                      Background="#080808"
                      Visibility="Collapsed"
                      Panel.ZIndex="3">

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Margin="0,0,0,45">

                                        <TextBlock Text="T"
                                                   Foreground="Cyan"
                                                   FontSize="64"
                                                   FontWeight="Bold"/>

                                        <TextBlock Text="E"
                                                   Foreground="Yellow"
                                                   FontSize="64"
                                                   FontWeight="Bold"/>

                                        <TextBlock Text="T"
                                                   Foreground="Purple"
                                                   FontSize="64"
                                                   FontWeight="Bold"/>

                                        <TextBlock Text="R"
                                                   Foreground="Green"
                                                   FontSize="64"
                                                   FontWeight="Bold"/>

                                        <TextBlock Text="I"
                                                   Foreground="Red"
                                                   FontSize="64"
                                                   FontWeight="Bold"/>

                                        <TextBlock Text="S"
                                                   Foreground="Blue"
                                                   FontSize="64"
                                                   FontWeight="Bold"/>

                                </StackPanel>

                                <TextBlock x:Name="WelcomeText"
                                           Text="Welcome"
                                           Foreground="Gray"
                                           FontSize="17"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,25"/>

                                <Button Content="PLAY"
                                        Width="200"
                                        Height="45"
                                        Margin="0,5"
                                        FontSize="19"
                                        FontWeight="Bold"
                                        Click="PlayButton_Click"/>

                                <Button Content="OPTIONS"
                                        Width="200"
                                        Height="45"
                                        Margin="0,5"
                                        FontSize="19"
                                        Click="OptionsButton_Click"/>

                                <Button Content="HIGHSCORES"
                                        Width="200"
                                        Height="45"
                                        Margin="0,5"
                                        FontSize="19"
                                        Click="HighScoresButton_Click"/>

                                <Button Content="LOGOUT"
                                        Width="200"
                                        Height="45"
                                        Margin="0,5"
                                        FontSize="19"
                                        Click="LogoutButton_Click"/>

                                <Button Content="EXIT"
                                        Width="200"
                                        Height="45"
                                        Margin="0,5"
                                        FontSize="19"
                                        Click="ExitButton_Click"/>

                        </StackPanel>
                </Grid>

                <Grid x:Name="GameScreen"
                      Visibility="Collapsed"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      RenderTransformOrigin="0.5,0.5">

                        <Grid.RenderTransform>
                                <TranslateTransform x:Name="GameScreenTransform"/>
                        </Grid.RenderTransform>

                        <Grid Width="620"
                              Height="720">

                                <Border Width="320"
                                        Height="720"
                                        HorizontalAlignment="Left"
                                        BorderBrush="#B89B4A"
                                        BorderThickness="2"
                                        CornerRadius="5"
                                        Padding="4">

                                        <UniformGrid x:Name="GameBoard"
                                                     Rows="20"
                                                     Columns="10"
                                                     Background="#050505"/>

                                </Border>

                                <StackPanel HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Width="250"
                                            Margin="0,0,0,0">

                                        <Border Background="#111111"
                                                BorderBrush="#B89B4A"
                                                BorderThickness="2"
                                                CornerRadius="5"
                                                Padding="15"
                                                Margin="0,0,0,15">

                                                <StackPanel>

                                                        <TextBlock Text="PLAYER"
                                                                   Foreground="Gray"
                                                                   FontSize="12"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,0,0,5"/>

                                                        <TextBlock x:Name="GamePlayerText"
                                                                   Text="Player"
                                                                   Foreground="White"
                                                                   FontSize="22"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center"/>

                                                </StackPanel>

                                        </Border>

                                        <Border Background="#111111"
                                                BorderBrush="#B89B4A"
                                                BorderThickness="2"
                                                CornerRadius="5"
                                                Padding="12"
                                                Margin="0,0,0,15">

                                                <StackPanel>

                                                        <TextBlock Text="NEXT"
                                                                   Foreground="Gray"
                                                                   FontSize="12"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,0,0,8"/>

                                                        <Border BorderBrush="#333333"
                                                                BorderThickness="1"
                                                                Width="100"
                                                                Height="100"
                                                                HorizontalAlignment="Center"
                                                                Padding="4">

                                                                <UniformGrid x:Name="NextPiecePreview"
                                                                             Rows="5"
                                                                             Columns="5"
                                                                             Background="#050505"/>

                                                        </Border>

                                                </StackPanel>

                                        </Border>

                                        <Border Background="#111111"
                                                BorderBrush="#B89B4A"
                                                BorderThickness="2"
                                                CornerRadius="5"
                                                Padding="15"
                                                Margin="0,0,0,15">

                                                <StackPanel>

                                                        <TextBlock Text="SCORE"
                                                                   Foreground="Gray"
                                                                   FontSize="12"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,0,0,5"/>

                                                        <TextBlock x:Name="ScoreText"
                                                                   Text="0"
                                                                   Foreground="White"
                                                                   FontSize="32"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center"/>

                                                </StackPanel>

                                        </Border>

                                        <Border Background="#111111"
                                                BorderBrush="#333333"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                Padding="15">

                                                <StackPanel>

                                                        <TextBlock Text="CONTROLS"
                                                                   Foreground="Gray"
                                                                   FontSize="12"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,0,0,10"/>

                                                        <TextBlock Text="← →  Move"
                                                                   Foreground="White"
                                                                   FontSize="14"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,2"/>

                                                        <TextBlock Text="↑  Rotate"
                                                                   Foreground="White"
                                                                   FontSize="14"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,2"/>

                                                        <TextBlock Text="↓  Soft Drop"
                                                                   Foreground="White"
                                                                   FontSize="14"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,2"/>

                                                        <TextBlock Text="SPACE  Hard Drop"
                                                                   Foreground="White"
                                                                   FontSize="14"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,2"/>

                                                        <TextBlock Text="ESC  Pause"
                                                                   Foreground="White"
                                                                   FontSize="14"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,2"/>

                                                </StackPanel>

                                        </Border>

                                </StackPanel>

                                <Grid x:Name="GameOverScreen"
                                      Background="#DD000000"
                                      Visibility="Collapsed"
                                      Panel.ZIndex="2">

                                        <Border Width="360"
                                                Padding="30"
                                                Background="#111111"
                                                BorderBrush="#B89B4A"
                                                BorderThickness="2"
                                                CornerRadius="6"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">

                                                <StackPanel>

                                                        <TextBlock Text="GAME OVER"
                                                                   Foreground="White"
                                                                   FontSize="36"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,0,0,15"/>

                                                        <TextBlock x:Name="FinalScoreText"
                                                                   Text="Score: 0"
                                                                   Foreground="White"
                                                                   FontSize="24"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,0,0,10"/>

                                                        <TextBlock x:Name="GameOverPlayerText"
                                                                   Text="Player:"
                                                                   Foreground="Gray"
                                                                   FontSize="16"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,0,0,25"/>

                                                        <Button Content="SAVE SCORE"
                                                                Width="180"
                                                                Height="40"
                                                                FontSize="16"
                                                                Click="SaveScoreButton_Click"/>

                                                        <Button Content="RESTART"
                                                                Width="180"
                                                                Height="40"
                                                                FontSize="16"
                                                                Margin="0,8,0,0"
                                                                Click="RestartButton_Click"/>

                                                        <Button Content="MAIN MENU"
                                                                Width="180"
                                                                Height="40"
                                                                FontSize="16"
                                                                Margin="0,8,0,0"
                                                                Click="MainMenuButton_Click"/>

                                                </StackPanel>

                                        </Border>

                                </Grid>

                                <Grid x:Name="PauseScreen"
                                      Background="#DD000000"
                                      Visibility="Collapsed"
                                      Panel.ZIndex="4">

                                        <Border Width="350"
                                                Padding="30"
                                                Background="#111111"
                                                BorderBrush="#B89B4A"
                                                BorderThickness="2"
                                                CornerRadius="6"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">

                                                <StackPanel>

                                                        <TextBlock Text="PAUSED"
                                                                   Foreground="White"
                                                                   FontSize="36"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,0,0,25"/>

                                                        <Button Content="RESUME"
                                                                Width="180"
                                                                Height="40"
                                                                FontSize="18"
                                                                Margin="0,5"
                                                                Click="ResumeButton_Click"/>

                                                        <Button Content="MAIN MENU"
                                                                Width="180"
                                                                Height="40"
                                                                FontSize="18"
                                                                Margin="0,5"
                                                                Click="PauseMainMenuButton_Click"/>

                                                        <Button Content="EXIT"
                                                                Width="180"
                                                                Height="40"
                                                                FontSize="18"
                                                                Margin="0,5"
                                                                Click="PauseExitButton_Click"/>

                                                </StackPanel>

                                        </Border>

                                </Grid>

                        </Grid>
                </Grid>

                <Grid x:Name="OptionsScreen"
                      Background="#080808"
                      Visibility="Collapsed"
                      Panel.ZIndex="4">

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                                <TextBlock Text="OPTIONS"
                                           Foreground="White"
                                           FontSize="36"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,30"/>

                                <TextBlock Text="Options will be added later."
                                           Foreground="Gray"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,30"/>

                                <Button Content="BACK"
                                        Width="160"
                                        Height="40"
                                        FontSize="18"
                                        Click="BackToMenuButton_Click"/>

                        </StackPanel>
                </Grid>

                <Grid x:Name="HighScoresScreen"
                      Background="#080808"
                      Visibility="Collapsed"
                      Panel.ZIndex="4">

                        <Border Width="400"
                                Padding="30"
                                Background="#111111"
                                BorderBrush="#B89B4A"
                                BorderThickness="2"
                                CornerRadius="6"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                                <StackPanel>

                                        <TextBlock Text="HIGHSCORES"
                                                   Foreground="White"
                                                   FontSize="32"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,25"/>

                                        <StackPanel x:Name="HighScoresList"
                                                    Margin="0,0,0,25"/>

                                        <Button Content="BACK"
                                                Width="160"
                                                Height="40"
                                                FontSize="18"
                                                HorizontalAlignment="Center"
                                                Click="BackToMenuButton_Click"/>

                                </StackPanel>

                        </Border>
                </Grid>

                <Grid x:Name="RegisterScreen"
                      Background="#080808"
                      Visibility="Collapsed"
                      Panel.ZIndex="5">

                        <Border Width="430"
                                Padding="45"
                                Background="#111111"
                                BorderBrush="#B89B4A"
                                BorderThickness="2"
                                CornerRadius="8"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                                <StackPanel>

                                        <TextBlock Text="REGISTER"
                                                   Foreground="White"
                                                   FontSize="36"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,30"/>

                                        <TextBlock Text="USERNAME"
                                                   Foreground="Gray"
                                                   FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,5"/>

                                        <TextBox x:Name="RegisterUsernameTextBox"
                                                 Width="220"
                                                 Height="32"
                                                 MaxLength="20"
                                                 HorizontalContentAlignment="Center"
                                                 FontSize="16"
                                                 Margin="0,0,0,15"/>

                                        <TextBlock Text="PASSWORD"
                                                   Foreground="Gray"
                                                   FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,5"/>

                                        <PasswordBox x:Name="RegisterPasswordBox"
                                                     Width="220"
                                                     Height="32"
                                                     FontSize="16"
                                                     Margin="0,0,0,25"/>

                                        <Button Content="REGISTER"
                                                Width="220"
                                                Height="40"
                                                FontSize="17"
                                                FontWeight="Bold"
                                                Margin="0,0,0,10"
                                                Click="CreateAccountButton_Click"/>

                                        <Button Content="BACK"
                                                Width="220"
                                                Height="40"
                                                FontSize="17"
                                                Click="BackToLoginButton_Click"/>

                                </StackPanel>

                        </Border>
                </Grid>

        </Grid>
</Window>
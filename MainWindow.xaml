                <Grid x:Name="LoginScreen"
                      Background="Transparent"
                      Panel.ZIndex="10">

                        <Border Width="450"
                                Padding="45"
                                Background="{StaticResource PanelBackground}"
                                BorderBrush="#B89B4A"
                                BorderThickness="1"
                                CornerRadius="10"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                                <StackPanel>

                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,0,0,8">

                                                <TextBlock Text="T"
                                                           Foreground="Cyan"
                                                           Style="{StaticResource LogoLetterStyle}"/>

                                                <TextBlock Text="E"
                                                           Foreground="Yellow"
                                                           Style="{StaticResource LogoLetterStyle}"/>

                                                <TextBlock Text="T"
                                                           Foreground="Purple"
                                                           Style="{StaticResource LogoLetterStyle}"/>

                                                <TextBlock Text="R"
                                                           Foreground="Green"
                                                           Style="{StaticResource LogoLetterStyle}"/>

                                                <TextBlock Text="I"
                                                           Foreground="Red"
                                                           Style="{StaticResource LogoLetterStyle}"/>

                                                <TextBlock Text="S"
                                                           Foreground="Blue"
                                                           Style="{StaticResource LogoLetterStyle}"/>

                                        </StackPanel>

                                        <TextBlock Text="BLOCK DROP"
                                                   Foreground="#B89B4A"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,35"/>

                                        <TextBlock Text="LOGIN"
                                                   Foreground="White"
                                                   FontSize="25"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,25"/>

                                        <TextBlock Text="USERNAME"
                                                   Foreground="#777777"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,6"/>

                                        <TextBox x:Name="LoginUsernameTextBox"
                                                 Width="240"
                                                 Height="34"
                                                 FontSize="16"
                                                 HorizontalContentAlignment="Center"
                                                 Margin="0,0,0,16"/>

                                        <TextBlock Text="PASSWORD"
                                                   Foreground="#777777"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,6"/>

                                        <PasswordBox x:Name="LoginPasswordBox"
                                                     Width="240"
                                                     Height="34"
                                                     FontSize="16"
                                                     HorizontalContentAlignment="Center"
                                                     Margin="0,0,0,25"/>

                                        <Button Content="LOGIN"
                                                Style="{StaticResource MenuButtonStyle}"
                                                Click="LoginButton_Click"/>

                                        <Button Content="REGISTER"
                                                Style="{StaticResource MenuButtonStyle}"
                                                Click="RegisterButton_Click"/>

                                        <Button Content="EXIT"
                                                Style="{StaticResource MenuButtonStyle}"
                                                Click="ExitButton_Click"/>

                                </StackPanel>

                        </Border>

                </Grid>

                <Grid x:Name="MainMenuScreen"
                      Background="Transparent"
                      Visibility="Collapsed"
                      Panel.ZIndex="3">

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Margin="0,0,0,8">

                                        <TextBlock Text="T"
                                                   Foreground="Cyan"
                                                   Style="{StaticResource LogoLetterStyle}"/>

                                        <TextBlock Text="E"
                                                   Foreground="Yellow"
                                                   Style="{StaticResource LogoLetterStyle}"/>

                                        <TextBlock Text="T"
                                                   Foreground="Purple"
                                                   Style="{StaticResource LogoLetterStyle}"/>

                                        <TextBlock Text="R"
                                                   Foreground="Green"
                                                   Style="{StaticResource LogoLetterStyle}"/>

                                        <TextBlock Text="I"
                                                   Foreground="Red"
                                                   Style="{StaticResource LogoLetterStyle}"/>

                                        <TextBlock Text="S"
                                                   Foreground="Blue"
                                                   Style="{StaticResource LogoLetterStyle}"/>

                                </StackPanel>

                                <TextBlock Text="BLOCK DROP"
                                           Foreground="#B89B4A"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,30"/>

                                <TextBlock x:Name="WelcomeText"
                                           Text="Welcome"
                                           Foreground="#888888"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,25"/>

                                <Button Content="PLAY"
                                        Style="{StaticResource MenuButtonStyle}"
                                        Click="PlayButton_Click"/>

                                <Button Content="OPTIONS"
                                        Style="{StaticResource MenuButtonStyle}"
                                        Click="OptionsButton_Click"/>

                                <Button Content="HIGHSCORES"
                                        Style="{StaticResource MenuButtonStyle}"
                                        Click="HighScoresButton_Click"/>

                                <Button Content="LOGOUT"
                                        Style="{StaticResource MenuButtonStyle}"
                                        Click="LogoutButton_Click"/>

                                <Button Content="EXIT"
                                        Style="{StaticResource MenuButtonStyle}"
                                        Click="ExitButton_Click"/>

                        </StackPanel>

                </Grid>

                <Grid x:Name="GameModeScreen"
                      Background="Transparent"
                      Visibility="Collapsed"
                      Panel.ZIndex="4">

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                                <TextBlock Text="GAME MODE"
                                           Style="{StaticResource ScreenTitleStyle}"
                                           Margin="0,0,0,8"/>

                                <TextBlock Text="SELECT YOUR CHALLENGE"
                                           Foreground="#B89B4A"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,30"/>

                                <Button Content="CLASSIC"
                                        Style="{StaticResource MenuButtonStyle}"
                                        Height="52"
                                        FontSize="19"
                                        Click="ClassicModeButton_Click"/>

                                <TextBlock Text="Standard Tetris"
                                           Foreground="#777777"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,10"/>

                                <Button Content="ENDLESS"
                                        Style="{StaticResource MenuButtonStyle}"
                                        Height="52"
                                        FontSize="19"
                                        Click="EndlessModeButton_Click"/>

                                <TextBlock Text="Survive as long as you can"
                                           Foreground="#777777"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,10"/>

                                <Button Content="SPRINT"
                                        Style="{StaticResource MenuButtonStyle}"
                                        Height="52"
                                        FontSize="19"
                                        Click="SprintModeButton_Click"/>

                                <TextBlock Text="Clear 40 lines as fast as possible"
                                           Foreground="#777777"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,10"/>

                                <Button Content="TIME ATTACK"
                                        Style="{StaticResource MenuButtonStyle}"
                                        Height="52"
                                        FontSize="19"
                                        Click="TimeAttackModeButton_Click"/>

                                <TextBlock Text="Score as much as you can in 2 minutes"
                                           Foreground="#777777"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,15"/>

                                <Button Content="BACK"
                                        Style="{StaticResource MenuButtonStyle}"
                                        Margin="0,10,0,0"
                                        Click="GameModeBackButton_Click"/>

                        </StackPanel>

                </Grid>

                <Grid x:Name="GameScreen"
                      Visibility="Collapsed"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      RenderTransformOrigin="0.5,0.5">

                        <Grid.RenderTransform>

                                <TranslateTransform x:Name="GameScreenTransform"/>

                        </Grid.RenderTransform>

                        <Grid Width="620"
                              Height="720">

                                <Border Width="320"
                                        Height="720"
                                        HorizontalAlignment="Left"
                                        BorderBrush="#B89B4A"
                                        BorderThickness="2"
                                        CornerRadius="5"
                                        Padding="4">
                                        <Border.Effect>
                                                <DropShadowEffect Color="#B89B4A"
                                                                  BlurRadius="22"
                                                                  ShadowDepth="0"
                                                                  Opacity="0.32"/>
                                        </Border.Effect>

                                        <UniformGrid x:Name="GameBoard"
                                                     Rows="20"
                                                     Columns="10"
                                                     Background="#050505"/>

                                </Border>

                                <StackPanel HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Width="250">

                                        <Border Style="{StaticResource PanelStyle}"
                                                Padding="15"
                                                Margin="0,0,0,15">

                                                <StackPanel>

                                                        <TextBlock Text="PLAYER"
                                                                   Foreground="#777777"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,0,0,5"/>

                                                        <TextBlock x:Name="GamePlayerText"
                                                                   Text="Player"
                                                                   Foreground="White"
                                                                   FontSize="22"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center"/>

                                                </StackPanel>

                                        </Border>

                                        <Border Style="{StaticResource PanelStyle}"
                                                Padding="15"
                                                Margin="0,0,0,15">

                                                <StackPanel>

                                                        <TextBlock Text="MODE"
                                                                   Foreground="#777777"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,0,0,5"/>

                                                        <TextBlock x:Name="GameModeText"
                                                                   Text="CLASSIC"
                                                                   Foreground="White"
                                                                   FontSize="20"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center"/>

                                                        <TextBlock x:Name="ModeInfoText"
                                                                   Text=""
                                                                   Foreground="#B89B4A"
                                                                   FontSize="13"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,5,0,0"/>

                                                </StackPanel>

                                        </Border>

                                        <Border Style="{StaticResource PanelStyle}"
                                                Padding="12"
                                                Margin="0,0,0,15">

                                                <StackPanel>

                                                        <TextBlock Text="NEXT"
                                                                   Foreground="#777777"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,0,0,8"/>

                                                        <Border BorderBrush="#333333"
                                                                BorderThickness="1"
                                                                Width="100"
                                                                Height="100"
                                                                HorizontalAlignment="Center"
                                                                Padding="4">

                                                                <UniformGrid x:Name="NextPiecePreview"
                                                                             Rows="5"
                                                                             Columns="5"
                                                                             Background="#050505"/>

                                                        </Border>

                                                </StackPanel>

                                        </Border>

                                        <Border Style="{StaticResource PanelStyle}"
                                                Padding="15"
                                                Margin="0,0,0,15">

                                                <StackPanel>

                                                        <TextBlock Text="SCORE"
                                                                   Foreground="#777777"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,0,0,5"/>

                                                        <TextBlock x:Name="ScoreText"
                                                                   Text="0"
                                                                   Foreground="White"
                                                                   FontSize="32"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center"/>

                                                </StackPanel>

                                        </Border>

                                        <Border Background="#0D0D0D"
                                                BorderBrush="#333333"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="15">

                                                <StackPanel>

                                                        <TextBlock Text="CONTROLS"
                                                                   Foreground="#777777"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,0,0,10"/>

                                                        <TextBlock Text="← →  Move"
                                                                   Foreground="White"
                                                                   FontSize="14"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,2"/>

                                                        <TextBlock Text="↑  Rotate"
                                                                   Foreground="White"
                                                                   FontSize="14"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,2"/>

                                                        <TextBlock Text="↓  Soft Drop"
                                                                   Foreground="White"
                                                                   FontSize="14"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,2"/>

                                                        <TextBlock Text="SPACE  Hard Drop"
                                                                   Foreground="White"
                                                                   FontSize="14"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,2"/>

                                                        <TextBlock Text="ESC  Pause"
                                                                   Foreground="White"
                                                                   FontSize="14"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,2"/>

                                                </StackPanel>

                                        </Border>

                                </StackPanel>

                                <Grid Width="320"
                                      Height="720"
                                      HorizontalAlignment="Left"
                                      IsHitTestVisible="False"
                                      Panel.ZIndex="1">

                                        <TextBlock x:Name="ScorePopupText"
                                                   Text="+100"
                                                   Foreground="#B89B4A"
                                                   FontSize="34"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="Collapsed"
                                                   Opacity="0">

                                                <TextBlock.RenderTransform>

                                                        <ScaleTransform x:Name="ScorePopupScale"
                                                                        ScaleX="1"
                                                                        ScaleY="1"/>

                                                </TextBlock.RenderTransform>

                                        </TextBlock>

                                        <TextBlock x:Name="ComboText"
                                                   Text="COMBO x2!"
                                                   Foreground="White"
                                                   FontSize="28"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="0,75,0,0"
                                                   Visibility="Collapsed"
                                                   Opacity="0">

                                                <TextBlock.RenderTransform>

                                                        <ScaleTransform x:Name="ComboScale"
                                                                        ScaleX="1"
                                                                        ScaleY="1"/>

                                                </TextBlock.RenderTransform>

                                        </TextBlock>

                                </Grid>

                                <Grid x:Name="GameOverScreen"
                                      Background="#DD000000"
                                      Visibility="Collapsed"
                                      Panel.ZIndex="2">

                                        <Border Width="380"
                                                Padding="30"
                                                Background="{StaticResource PanelBackground}"
                                                BorderBrush="#B89B4A"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">

                                                <StackPanel>

                                                        <TextBlock x:Name="GameOverTitleText"
                                                                   Text="GAME OVER"
                                                                   Foreground="White"
                                                                   FontSize="36"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,0,0,15"/>

                                                        <TextBlock x:Name="FinalScoreText"
                                                                   Text="Score: 0"
                                                                   Foreground="White"
                                                                   FontSize="24"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,0,0,10"/>

                                                        <TextBlock x:Name="GameOverPlayerText"
                                                                   Text="Player:"
                                                                   Foreground="#777777"
                                                                   FontSize="16"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,0,0,25"/>

                                                        <Button Content="SAVE SCORE"
                                                                Style="{StaticResource MenuButtonStyle}"
                                                                Click="SaveScoreButton_Click"/>

                                                        <Button Content="RESTART"
                                                                Style="{StaticResource MenuButtonStyle}"
                                                                Margin="0,8,0,0"
                                                                Click="RestartButton_Click"/>

                                                        <Button Content="MAIN MENU"
                                                                Style="{StaticResource MenuButtonStyle}"
                                                                Margin="0,8,0,0"
                                                                Click="MainMenuButton_Click"/>

                                                </StackPanel>

                                        </Border>

                                </Grid>

                                <Grid x:Name="PauseScreen"
                                      Background="#DD000000"
                                      Visibility="Collapsed"
                                      Panel.ZIndex="4">

                                        <Border Width="370"
                                                Padding="30"
                                                Background="{StaticResource PanelBackground}"
                                                BorderBrush="#B89B4A"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">

                                                <StackPanel>

                                                        <TextBlock Text="PAUSED"
                                                                   Foreground="White"
                                                                   FontSize="36"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,0,0,25"/>

                                                        <Button Content="RESUME"
                                                                Style="{StaticResource MenuButtonStyle}"
                                                                Click="ResumeButton_Click"/>

                                                        <Button Content="MAIN MENU"
                                                                Style="{StaticResource MenuButtonStyle}"
                                                                Click="PauseMainMenuButton_Click"/>

                                                        <Button Content="EXIT"
                                                                Style="{StaticResource MenuButtonStyle}"
                                                                Click="PauseExitButton_Click"/>

                                                </StackPanel>

                                        </Border>

                                </Grid>

                        </Grid>

                </Grid>

                <Grid x:Name="OptionsScreen"
                      Background="Transparent"
                      Visibility="Collapsed"
                      Panel.ZIndex="4">

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                                <TextBlock Text="OPTIONS"
                                           Style="{StaticResource ScreenTitleStyle}"
                                           Margin="0,0,0,10"/>

                                <TextBlock Text="SETTINGS COMING SOON"
                                           Foreground="#B89B4A"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,25"/>

                                <TextBlock Text="Options will be added later."
                                           Foreground="#777777"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,30"/>

                                <Button Content="BACK"
                                        Style="{StaticResource MenuButtonStyle}"
                                        Click="BackToMenuButton_Click"/>

                        </StackPanel>

                </Grid>

                <Grid x:Name="HighScoresScreen"
                      Background="Transparent"
                      Visibility="Collapsed"
                      Panel.ZIndex="4">

                        <Border Width="500"
                                Padding="30"
                                Background="{StaticResource PanelBackground}"
                                BorderBrush="#B89B4A"
                                BorderThickness="1"
                                CornerRadius="8"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                                <StackPanel>

                                        <TextBlock Text="HIGHSCORES"
                                                   Style="{StaticResource ScreenTitleStyle}"
                                                   FontSize="32"
                                                   Margin="0,0,0,10"/>

                                        <TextBlock x:Name="PlayerHighScoreText"
                                                   Text="YOUR BEST: 0    SCORES: 0"
                                                   Foreground="#B89B4A"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,20"/>

                                        <Grid Margin="8,0,8,5">

                                                <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="55"/>
                                                        <ColumnDefinition Width="1*"/>
                                                        <ColumnDefinition Width="100"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="RANK"
                                                           Foreground="#777777"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Grid.Column="0"/>

                                                <TextBlock Text="PLAYER"
                                                           Foreground="#777777"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Grid.Column="1"/>

                                                <TextBlock Text="SCORE"
                                                           Foreground="#777777"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Right"
                                                           Grid.Column="2"/>

                                        </Grid>

                                        <StackPanel x:Name="HighScoresList"
                                                    Margin="0,0,0,25"/>

                                        <Button Content="BACK"
                                                Style="{StaticResource MenuButtonStyle}"
                                                Click="BackToMenuButton_Click"/>

                                </StackPanel>

                        </Border>

                </Grid>

                <Grid x:Name="RegisterScreen"
                      Background="Transparent"
                      Visibility="Collapsed"
                      Panel.ZIndex="5">

                        <Border Width="450"
                                Padding="45"
                                Background="{StaticResource PanelBackground}"
                                BorderBrush="#B89B4A"
                                BorderThickness="1"
                                CornerRadius="10"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                                <StackPanel>

                                        <TextBlock Text="REGISTER"
                                                   Foreground="White"
                                                   FontSize="36"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,30"/>

                                        <TextBlock Text="USERNAME"
                                                   Foreground="#777777"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,6"/>

                                        <TextBox x:Name="RegisterUsernameTextBox"
                                                 Width="240"
                                                 Height="34"
                                                 MaxLength="20"
                                                 HorizontalContentAlignment="Center"
                                                 FontSize="16"
                                                 Margin="0,0,0,16"/>

                                        <TextBlock Text="PASSWORD"
                                                   Foreground="#777777"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,6"/>

                                        <PasswordBox x:Name="RegisterPasswordBox"
                                                     Width="240"
                                                     Height="34"
                                                     FontSize="16"
                                                     Margin="0,0,0,25"/>

                                        <Button Content="REGISTER"
                                                Style="{StaticResource MenuButtonStyle}"
                                                Click="CreateAccountButton_Click"/>

                                        <Button Content="BACK"
                                                Style="{StaticResource MenuButtonStyle}"
                                                Click="BackToLoginButton_Click"/>

                                </StackPanel>

                        </Border>

                </Grid>

        </Grid>

</Window>

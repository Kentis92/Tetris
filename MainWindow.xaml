<Window x:Class="Tetris.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tetris"
        Width="300"
        Height="600"
        Background="Black">
    <Grid>

        <Grid x:Name="MainMenuScreen"
              Background="Black"
              Panel.ZIndex="3">

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <TextBlock Text="TETRIS"
                           Foreground="White"
                           FontSize="42"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,40"/>

                <Button Content="PLAY"
                        Width="160"
                        Height="40"
                        Margin="0,5"
                        FontSize="18"
                        Click="PlayButton_Click"/>

                <Button Content="OPTIONS"
                        Width="160"
                        Height="40"
                        Margin="0,5"
                        FontSize="18"
                        Click="OptionsButton_Click"/>

                <Button Content="HIGHSCORES"
                        Width="160"
                        Height="40"
                        Margin="0,5"
                        FontSize="18"
                        Click="HighScoresButton_Click"/>

                <Button Content="EXIT"
                        Width="160"
                        Height="40"
                        Margin="0,5"
                        FontSize="18"
                        Click="ExitButton_Click"/>

            </StackPanel>
        </Grid>

        <Grid x:Name="GameScreen"
              Visibility="Collapsed">

            <UniformGrid x:Name="GameBoard"
                         Rows="20"
                         Columns="10"
                         Margin="10"/>

            <StackPanel HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="15,8,0,0"
                        Panel.ZIndex="1">

                <TextBlock Text="Next"
                           Foreground="Gray"
                           FontSize="12"/>

                <UniformGrid x:Name="NextPiecePreview"
                             Rows="4"
                             Columns="4"
                             Width="56"
                             Height="56"
                             Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,8,15,0"
                        Panel.ZIndex="1">

                <TextBlock x:Name="ScoreText"
                           Text="Score: 0"
                           Foreground="White"
                           FontSize="16"
                           HorizontalAlignment="Right"/>

                <TextBlock x:Name="HighScoreText"
                           Text="High Score: 0"
                           Foreground="Gray"
                           FontSize="12"
                           HorizontalAlignment="Right"/>
            </StackPanel>

            <Grid x:Name="GameOverScreen"
                  Background="#DD000000"
                  Visibility="Collapsed"
                  Panel.ZIndex="2">

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <TextBlock Text="GAME OVER"
                               Foreground="White"
                               FontSize="40"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <TextBlock x:Name="FinalScoreText"
                               Text="Score: 0"
                               Foreground="White"
                               FontSize="26"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <Button Content="Restart"
                            Width="120"
                            Height="40"
                            FontSize="18"
                            Click="RestartButton_Click"/>

                    <Button Content="Main Menu"
                            Width="120"
                            Height="40"
                            FontSize="18"
                            Margin="0,10,0,0"
                            Click="MainMenuButton_Click"/>

                </StackPanel>
            </Grid>
        </Grid>

        <Grid x:Name="OptionsScreen"
              Background="Black"
              Visibility="Collapsed"
              Panel.ZIndex="4">

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <TextBlock Text="OPTIONS"
                           Foreground="White"
                           FontSize="36"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"/>

                <TextBlock Text="Options will be added later."
                           Foreground="Gray"
                           FontSize="16"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"/>

                <Button Content="BACK"
                        Width="160"
                        Height="40"
                        FontSize="18"
                        Click="BackToMenuButton_Click"/>

            </StackPanel>
        </Grid>

        <Grid x:Name="HighScoresScreen"
              Background="Black"
              Visibility="Collapsed"
              Panel.ZIndex="4">

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <TextBlock Text="HIGHSCORES"
                           Foreground="White"
                           FontSize="36"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"/>

                <TextBlock Text="Highscores will be added next."
                           Foreground="Gray"
                           FontSize="16"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"/>

                <Button Content="BACK"
                        Width="160"
                        Height="40"
                        FontSize="18"
                        Click="BackToMenuButton_Click"/>

            </StackPanel>
        </Grid>

    </Grid>
</Window>